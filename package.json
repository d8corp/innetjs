{
  "name": "innetjs",
  "version": "4.0.0-alpha.19",
  "description": "CLI for innet boilerplate",
  "homepage": "https://github.com/d8corp/innetjs",
  "author": "Mikhail Lysikov <d8corp@mail.ru>",
  "license": "MIT",
  "main": "index.js",
  "module": "index.mjs",
  "esnext": "index.mjs",
  "jsnext:main": "index.mjs",
  "types": "index.d.ts",
  "private": true,
  "bin": {
    "innetjs": "bin/innet"
  },
  "scripts": {
    "build": "innetjs release -e -tc -lc",
    "release": "innetjs release -p -e -tc -lc",
    "test": "jest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "start": "npm run build && cd release && npm link",
    "stop": "npm unlink innetjs -g",
    "restart": "npm run stop && npm start",
    "patch": "innetjs patch",
    "minor": "innetjs minor",
    "major": "innetjs major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d8corp/innetjs.git"
  },
  "keywords": [
    "watch",
    "state",
    "stateful",
    "reaction",
    "reactions",
    "react",
    "reactive",
    "observe",
    "observable",
    "framework",
    "view",
    "cli",
    "front-end"
  ],
  "bugs": {
    "url": "https://github.com/d8corp/innetjs/issues"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "@cantinc/logger": "^1.2.0",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "address": "^1.2.1",
    "adm-zip": "^0.5.10",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "chalk": "^4.1.2",
    "cli-select": "^1.1.2",
    "commander": "^9.4.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "express": "^5.2.1",
    "express-http-proxy": "^1.6.3",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "lines-and-columns": "^2.0.3",
    "postcss": "^8.5.26",
    "prompts": "^2.4.2",
    "rolldown": "^1.2.4",
    "rollup-plugin-external-node-modules": "^1.0.1",
    "rollup-plugin-filesize": "^9.1.2",
    "rollup-plugin-import-assets": "^1.1.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-node-externals": "^5.0.2",
    "rollup-plugin-polyfill-node": "^0.11.0",
    "rollup-plugin-preserve-shebangs": "^0.2.0",
    "rollup-plugin-process-env": "^1.0.7",
    "rollup-plugin-string": "^3.0.0",
    "rollup-plugin-styles": "^4.0.0",
    "sass": "^1.55.0",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.0",
    "@types/autoprefixer": "^10.2.0",
    "@types/execa": "^2.0.0",
    "@types/express": "^4.17.14",
    "@types/express-http-proxy": "^1.6.3",
    "@types/fs-extra": "^9.0.13",
    "@types/glob": "^8.0.0",
    "@types/jest": "^29.2.0",
    "@types/node": "^18.11.8",
    "@types/prompts": "^2.4.1",
    "@types/rollup": "^0.54.0",
    "@types/tmp": "^0.2.3",
    "core-js": "^3.26.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "innet-jest": "^1.3.5",
    "innetjs": "4.0.0-alpha.18",
    "jest": "^29.2.2",
    "minimist": "^1.2.7",
    "neostandard": "^0.13.0",
    "rimraf": "^3.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
